# AWS Configuration
AWS_ACCOUNT_ID=your_aws_account_id
AWS_REGION=us-east-1

# ECR Repositories
ECR_BACKEND_REPO=auto-blog-backend
ECR_FRONTEND_REPO=auto-blog-frontend

# HuggingFace API Key (store in AWS Parameter Store)
HF_API_KEY=your_huggingface_api_key_here

# Database
DB_NAME=blogdb
DB_USER=admin
DB_PASSWORD=password123